---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Himanshu Dixit — AI Systems Researcher & Software Engineer" } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <div class="container">
      <header class="header">
        <h1 class="name"><a href={`${base}/`}>Himanshu Dixit</a></h1>
        <p class="role">AI Systems Researcher &amp; Software Engineer</p>
        <div class="nav-links">
          <a href={`${base}/`}>Overview</a>
          <a href={`${base}/research`}>Research</a>
          <a href={`${base}/systems`}>Systems &amp; Code</a>
          <a href={`${base}/publications`}>Publications</a>
          <a href="https://github.com/Himan-D" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="mailto:himan@trinetralabs.ai">Contact</a>
        </div>
      </header>
      <hr class="divider" />
      <main>
        <slot />
      </main>
      <footer class="footer">
        <hr class="divider" />
        <p>Himanshu Dixit · <a href="https://github.com/Himan-D" target="_blank" rel="noopener noreferrer">GitHub</a> · <a href="https://www.linkedin.com/in/him-d/" target="_blank" rel="noopener noreferrer">LinkedIn</a> · <a href="mailto:himan@trinetralabs.ai">himan@trinetralabs.ai</a></p>
      </footer>
    </div>
  </body>
</html>
