---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  activeTab?: 'overview' | 'research' | 'systems' | 'publications';
}

const { 
  title, 
  description = "Himanshu Dixit — AI Systems Researcher & Systems Engineer focusing on autonomous agent runtimes, high-throughput inference, and continuous sequence models.",
  activeTab = 'overview'
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://himan-d.github.io').toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Himanshu Dixit" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Meta -->
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://avatars.githubusercontent.com/u/262577684?v=4" />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://avatars.githubusercontent.com/u/262577684?v=4" />

    <!-- Google Scholar Discovery -->
    <meta name="citation_author" content="Himanshu Dixit" />
  </head>
  <body>
    <div class="container">
      <header class="header">
        <div class="header-grid">
          <div class="header-text">
            <h1 class="name"><a href={`${base}/`}>Himanshu Dixit</a></h1>
            <p class="title-role">AI Systems Researcher &amp; Systems Engineer</p>
            <p class="affiliation">Focus: Autonomous Agents · High-Throughput Inference · Continuous Sequence Models</p>
            <div class="coords">
              <a href="mailto:himan@trinetralabs.ai">Email</a> · 
              <a href="https://github.com/Himan-D" target="_blank" rel="noopener noreferrer">GitHub</a> · 
              <a href="https://www.linkedin.com/in/him-d/" target="_blank" rel="noopener noreferrer">LinkedIn</a> · 
              <a href={`${base}/publications`}>Papers &amp; Preprints</a>
            </div>
          </div>
          <div class="portrait-wrapper">
            <img 
              src="https://avatars.githubusercontent.com/u/262577684?v=4" 
              alt="Himanshu Dixit" 
              class="portrait" 
              loading="eager"
            />
          </div>
        </div>

        <nav class="nav-bar">
          <a href={`${base}/`} class={activeTab === 'overview' ? 'active' : ''}>Overview</a>
          <a href={`${base}/research`} class={activeTab === 'research' ? 'active' : ''}>Research Agenda</a>
          <a href={`${base}/systems`} class={activeTab === 'systems' ? 'active' : ''}>Systems &amp; Code</a>
          <a href={`${base}/publications`} class={activeTab === 'publications' ? 'active' : ''}>Publications &amp; Preprints</a>
        </nav>
      </header>

      <hr class="divider" />

      <main>
        <slot />
      </main>


    </div>

    <!-- Minimal progressive copy helper -->
    <script is:inline>
      function copyBibtex(btn, codeId) {
        const el = document.getElementById(codeId);
        if (!el) return;
        navigator.clipboard.writeText(el.innerText).then(() => {
          const orig = btn.innerText;
          btn.innerText = 'Copied!';
          setTimeout(() => { btn.innerText = orig; }, 1800);
        });
      }
    </script>
  </body>
</html>
